      "credentials": {
        "googlePalmApi": {
          "id": "lnYFfhqKYm4FH0mI",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const output = $json.output || \"\";\n\nconst name =\n  output.match(/Hello,\\s*([^!]+)!/i)?.[1]?.trim() || \"\";\n\nconst date_of_birth =\n  output.match(/birth information\\s*\\(([^,]+),/i)?.[1]?.trim() || \"\";\n\nconst time_of_birth =\n  output.match(/at\\s+([^,]+)\\s+in\\s+/i)?.[1]?.trim() || \"\";\n\nconst place_of_birth =\n  output.match(/in\\s+([A-Za-z\\s]+)\\)/i)?.[1]?.trim() || \"\";\n\nreturn [\n  {\n    json: {\n      name,\n      date_of_birth,\n      time_of_birth,\n      place_of_birth,\n      output\n    }\n  }\n];"
      },
