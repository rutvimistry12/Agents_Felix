      "id": "8cecf2e2-fd23-4d2b-b0dc-602843c1a3a1",
      "name": "Merge Websites",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        256,
        160
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-Website-Monitor/1.0"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "d4b638c6-ef41-4fae-be15-720252d81267",
      "name": "Check Website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        512,
        160
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const input = $input.all();\nreturn input.map(item => {\n  const d = item.json;\n  const website = d.name || d.url || 'Unknown Website';\n  const url = d.url || '';\n  const expected = Number(d.expectedStatus || 200);\n  const statusCode = Number(d.statusCode ?? d.status ?? d.httpCode ?? d.response?.statusCode ?? 0);\n  const responseTime = Number(d.responseTime ?? d.elapsedTime ?? d.duration ?? 0);\n  const errorText = d.error?.message || d.message || '';\n  const isUp = statusCode >= 200 && statusCode < 400;\n  const statusMatches = statusCode === expected;\n  let alertType = 'UP';\n  let severity = 'INFO';\n  if (!statusCode) { alertType = 'DOWN'; severity = 'CRITICAL'; }\n  else if (!statusMatches || !isUp) { alertType = 'HTTP_ERROR'; severity = statusCode >= 500 ? 'CRITICAL' : 'WARNING'; }\n  return {json:{website,url,expectedStatus:expected,statusCode,responseTimeMs:responseTime,isUp,statusMatches,alertType,severity,error:errorText,checkedAt:new Date().toISOString()}};\n});"
      },
      "id": "7ad3f21c-2728-497c-8c52-5f763a7e5d45",
      "name": "Analyze Website Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        160
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.isUp }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3dc09e8a-55e9-4659-83bb-7531cf75beb1",
      "name": "Website Is Up?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        992,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const d = item.json;\n  return {json:{...d,message:`🟢 WEBSITE UP\n\nWebsite: ${d.website}\nURL: ${d.url}\nHTTP Status: ${d.statusCode}\nResponse Time: ${d.responseTimeMs ? d.responseTimeMs + ' ms' : 'N/A'}\nChecked: ${d.checkedAt}`}};\n});"
      },
      "id": "747bb8a7-9e3b-4055-bca1-d343b7e40729",
      "name": "Create Healthy Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1232,
        48
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const d = item.json;\n  return {json:{...d,message:`🚨 WEBSITE ALERT\n\nWebsite: ${d.website}\nURL: ${d.url}\nStatus: ${d.statusCode || 'NO RESPONSE'}\nExpected: ${d.expectedStatus}\nAlert: ${d.alertType}\nSeverity: ${d.severity}\nResponse Time: ${d.responseTimeMs ? d.responseTimeMs + ' ms' : 'N/A'}\nError: ${d.error || 'Website did not return a valid response'}\nChecked: ${d.checkedAt}`}};\n});"
      },
      "id": "9216f354-034c-4936-abf4-7088a9966e86",
      "name": "Create Alert Message",
