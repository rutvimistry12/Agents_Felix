    {
      "parameters": {
        "jsCode": "const output = $json.output;\n\nif (!output) {\n  throw new Error(\"AI Agent output is missing.\");\n}\n\nconst cleaned = output\n  .replace(/\\\\n/g, \"\\n\")\n  .replace(/\\\\\"/g, '\"')\n  .trim();\n\nlet result;\n\ntry {\n  result = JSON.parse(cleaned);\n} catch (error) {\n  throw new Error(\"Invalid AI JSON: \" + cleaned);\n}\n\nreturn [\n  {\n    json: {\n      employee_id: result.employee_id || \"\",\n      employee_name: result.employee_name || \"\",\n      department: result.department || \"\",\n      performance_level: result.performance_level || \"\",\n      performance_score: result.performance_score || 0,\n\n      strengths: Array.isArray(result.strengths)\n        ? result.strengths.join(\", \")\n        : result.strengths || \"\",\n\n      areas_for_improvement: Array.isArray(result.areas_for_improvement)\n        ? result.areas_for_improvement.join(\", \")\n        : result.areas_for_improvement || \"\",\n\n      summary: result.summary || \"\",\n\n      recommendations: Array.isArray(result.recommendations)\n        ? result.recommendations.join(\", \")\n        : result.recommendations || \"\"\n    }\n  }\n];"
      },
