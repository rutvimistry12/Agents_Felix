    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nlet raw = input.output || input.text || input.response || input;\n\nlet data;\n\nif (typeof raw === 'string') {\n  raw = raw\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```\\s*/i, '')\n    .replace(/\\s*```$/i, '')\n    .trim();\n\n  try {\n    data = JSON.parse(raw);\n  } catch (error) {\n    throw new Error('AI returned invalid JSON: ' + raw);\n  }\n} else {\n  data = raw;\n}\n\nreturn [\n  {\n    json: {\n      incidentId: data.incidentId || 'INC001',\n      severity: String(data.severity || 'LOW').toUpperCase(),\n      category: data.category || 'OTHER',\n      impact: data.impact || '',\n      urgency: String(data.urgency || 'LOW').toUpperCase(),\n      affectedService: data.affectedService || '',\n      affectedUsers: data.affectedUsers || '',\n      summary: data.summary || '',\n      rootCause: data.rootCause || '',\n      recommendedAction: data.recommendedAction || '',\n      assignedTeam: data.assignedTeam || '',\n      responseTime: data.responseTime || '',\n      status: data.status || 'OPEN',\n      createdAt: new Date().toISOString()\n    }\n  }\n];"
      },
