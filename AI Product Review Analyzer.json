      "name": "Edit Fields"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this product review.\n\nProduct:\n{{ $json.productName }}\n\nReview:\n{{ $json.review }}\n\nReturn the result in JSON with exactly these fields:\n\n{\n  \"sentiment\": \"Positive/Neutral/Negative\",\n  \"rating\": 1,\n  \"summary\": \"\",\n  \"strengths\": [],\n  \"issues\": [],\n  \"product_quality\": \"\",\n  \"delivery_experience\": \"\",\n  \"recommendation\": \"Yes/No\"\n}",
        "options": {
          "systemMessage": "You are an AI Product Review Analyzer.\n\nAnalyze customer product reviews objectively.\n\nIdentify:\n- overall sentiment\n- estimated rating from 1 to 5\n- summary\n- product strengths\n- problems/issues\n- product quality\n- delivery experience\n- whether the customer appears likely to recommend the product\n\nReturn only valid JSON.\nDo not add markdown or explanations outside the JSON."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        336,
        -128
      ],
      "id": "fa8dc96a-3d76-4f19-8a6f-5c35b8e30b37",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.1-flash-lite",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        208,
        80
      ],
      "id": "8995566a-6e6f-4516-aada-baafc164be88",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "x7ZKneu4wUTlMGtO",
          "name": "Google Gemini(PaLM) Api account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const output = $json.output;\n\nif (!output) {\n  throw new Error(\"AI Agent output is missing.\");\n}\n\n// Convert escaped/newline JSON into normal JSON\nconst cleaned = output\n  .replace(/\\\\n/g, \"\\n\")\n  .replace(/\\\\\"/g, '\"')\n  .trim();\n\nlet result;\n\ntry {\n  result = JSON.parse(cleaned);\n} catch (error) {\n  throw new Error(\"Could not parse AI Agent JSON: \" + cleaned);\n}\n\nreturn [\n  {\n    json: {\n      sentiment: result.sentiment || \"\",\n      rating: result.rating || \"\",\n      summary: result.summary || \"\",\n      strengths: Array.isArray(result.strengths)\n        ? result.strengths.join(\", \")\n        : result.strengths || \"\",\n      issues: Array.isArray(result.issues)\n        ? result.issues.join(\", \")\n        : result.issues || \"\",\n      product_quality: result.product_quality || \"\",\n      delivery_experience: result.delivery_experience || \"\",\n      recommendation: result.recommendation || \"\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -112
      ],
      "id": "40c9928c-4a99-446d-aa21-7e94e7310e4e",
