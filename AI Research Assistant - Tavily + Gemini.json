              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\"query\": \"{{$json.researchTopic}}\", \"search_depth\": \"basic\", \"topic\": \"general\", \"max_results\": {{$json.maxResults}}, \"include_answer\": true}",
        "options": {}
      },
      "id": "387dffe1-c186-4b1c-a8bb-80ef3ed882d9",
      "name": "Tavily Web Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1952,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const topic = $('Research Topic').first().json.researchTopic;\nconst data = $input.first().json;\nconst results = Array.isArray(data.results) ? data.results : [];\nconst sources = results.map((r, i) => `${i + 1}. ${r.title || 'Untitled'}\\nURL: ${r.url || ''}\\nSummary: ${r.content || ''}`).join('\\n\\n');\nreturn [{ json: { researchTopic: topic, tavilyAnswer: data.answer || '', sources, researchData: `Tavily answer:\\n${data.answer || ''}\\n\\nSources:\\n${sources}` } }];"
      },
      "id": "ec457e12-7c2e-43d9-b294-3850a330fc39",
      "name": "Prepare Research",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2192,
        112
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "AQ.Ab8RN6LRDe9iUebHGeFVtDsvhuVrgQnL-a-GFuXc0tXhBzTVww"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({contents:[{parts:[{text:`You are a research assistant. Write a clear, factual research report from the supplied web research. Do not invent facts.\\n\\nTopic: ${$json.researchTopic}\\n\\nWeb research:\\n${$json.researchData}\\n\\nUse exactly these Markdown sections:\\n# Research Report\\n## Executive Summary\\n## Key Findings\\n## Detailed Analysis\\n## Important Facts and Data\\n## Limitations\\n## Conclusion\\n## Sources\\nFor Sources, preserve the URLs supplied by Tavily.`}]}]}) }}",
        "options": {}
      },
      "id": "c50f9e95-2656-4838-9c1b-248372e07386",
      "name": "Generate Research Report - Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2448,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst text = r?.candidates?.[0]?.content?.parts?.map(p => p.text || '').join('') || '';\nif (!text) throw new Error('Gemini returned no text. Check your Gemini API key and API access.');\nreturn [{json:{success:true, researchTopic:$('Prepare Research').first().json.researchTopic, report:text}}];"
      },
      "id": "57fb8878-4b4a-4ee6-bbb3-568bdab41631",
      "name": "Final Report",
