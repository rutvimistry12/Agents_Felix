    {
      "parameters": {
        "jsCode": "const categories = {\n  Documents:/\\.(pdf|doc|docx|txt|rtf|odt|md)$/i,\n  Images:/\\.(jpg|jpeg|png|gif|webp|bmp|svg|tiff)$/i,\n  Spreadsheets:/\\.(xls|xlsx|csv|ods|tsv)$/i,\n  Presentations:/\\.(ppt|pptx|odp)$/i,\n  Archives:/\\.(zip|rar|7z|tar|gz)$/i,\n  Audio:/\\.(mp3|wav|aac|flac|m4a|ogg)$/i,\n  Video:/\\.(mp4|mkv|avi|mov|webm|wmv)$/i,\n  Code:/\\.(js|ts|py|java|php|html|css|json|xml|sql|cpp|c|cs|go|rs|sh)$/i\n};\nfunction classify(name,mime){\n  const n=String(name||''), m=String(mime||'').toLowerCase();\n  for(const [c,re] of Object.entries(categories)) if(re.test(n)) return c;\n  if(m.includes('image')) return 'Images';\n  if(m.includes('pdf')||m.includes('document')||m.includes('text')) return 'Documents';\n  if(m.includes('spreadsheet')||m.includes('csv')) return 'Spreadsheets';\n  if(m.includes('presentation')) return 'Presentations';\n  if(m.includes('audio')) return 'Audio';\n  if(m.includes('video')) return 'Video';\n  return 'Other';\n}\nreturn $input.all().filter(i=>!String(i.json.mimeType||'').includes('folder')).map(i=>({\n  json:{\n    fileId:i.json.id||i.json.fileId,\n    fileName:i.json.name||'Unnamed file',\n    mimeType:i.json.mimeType||'',\n    size:i.json.size||0,\n    modifiedTime:i.json.modifiedTime||'',\n    category:classify(i.json.name,i.json.mimeType),\n    destinationRootFolderId:$('Organizer Settings').first().json.destinationRootFolderId,\n    dryRun:$('Organizer Settings').first().json.dryRun\n  }\n}));"
      },
