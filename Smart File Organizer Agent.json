      "parameters": {
        "jsCode": "const rows=$input.all().map(i=>i.json);\nconst report={success:true,generatedAt:new Date().toISOString(),totalProcessed:rows.length,moved:rows.filter(x=>x.status==='MOVED').length,skipped:rows.filter(x=>x.status==='SKIPPED').length,dryRun:rows.filter(x=>x.status==='DRY_RUN').length,byCategory:{}};\nfor(const r of rows) report.byCategory[r.category]=(report.byCategory[r.category]||0)+1;\nreturn [{json:{...report,details:rows}}];"
