        "jsCode": "const source=$('Prepare Destination').item.json;\nconst matches=$input.all().map(i=>i.json).filter(x=>(x.name||'')===source.destinationFolderName && String(x.mimeType||'').includes('folder'));\nreturn [{json:{...source,destinationFolderId:matches[0]?.id||'',folderFound:!!matches[0]}}];"
