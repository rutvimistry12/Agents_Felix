    {
      "parameters": {
        "jsCode": "const jobs = [];\n\nfor (const item of items) {\n\n  const job = item.json;\n\n  const title = job[\"job title\"] || \"\";\n  const company = job[\"company\"] || \"\";\n  const location = job[\"locstion\"] || \"\";\n  const link = job[\"apply link\"] || \"\";\n  const summary = job[\"summmary\"] || \"\";\n\n  jobs.push(`\n    <div style=\"\n      border:1px solid #ddd;\n      border-radius:10px;\n      padding:18px;\n      margin-bottom:15px;\n      font-family:Arial,sans-serif;\n    \">\n\n      <h2>${title || \"Job Opportunity\"}</h2>\n\n      <p>\n        <b>🏢 Company:</b> ${company || \"Not specified\"}\n      </p>\n\n      <p>\n        <b>📍 Location:</b> ${location || \"Not specified\"}\n      </p>\n\n      <p>\n        <b>📝 Summary:</b><br>\n        ${summary || \"No summary available\"}\n      </p>\n\n      <p>\n        <b>🔗 Apply:</b>\n        ${\n          link\n            ? `<a href=\"${link}\" target=\"_blank\">View Job & Apply</a>`\n            : \"Link not available\"\n        }\n      </p>\n\n    </div>\n  `);\n}\n\nreturn [\n  {\n    json: {\n      subject: `💼 ${jobs.length} New Job Alerts`,\n      message: `\n        <div style=\"font-family:Arial,sans-serif;max-width:700px;\">\n\n          <h1>💼 New Job Alerts</h1>\n\n          <p>Here are the latest job opportunities:</p>\n\n          ${jobs.join(\"\")}\n\n          <hr>\n\n          <p style=\"font-size:12px;color:#777;\">\n            This job alert was generated automatically.\n          </p>\n\n        </div>\n      `\n    }\n  }\n];"
      },
