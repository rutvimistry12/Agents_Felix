    {
      "parameters": {
        "jsCode": "const input = $json.output || $json.text || $json.content;\n\nlet data;\n\ntry {\n  data = typeof input === \"string\"\n    ? JSON.parse(input)\n    : input;\n} catch (error) {\n  return [{\n    json: {\n      success: false,\n      error: \"Invalid JSON returned by AI Agent\",\n      raw_output: input\n    }\n  }];\n}\n\nconst invoice = data.invoice_details || {};\nconst seller = invoice.seller || {};\nconst customer = invoice.customer || {};\nconst taxes = invoice.taxes || {};\nconst payment = invoice.payment_details || {};\n\nreturn [{\n  json: {\n\n    success: true,\n\n    // Seller\n    seller_name: seller.company_name || \"Not Found\",\n    seller_address: seller.address || \"Not Found\",\n    seller_gstin: seller.gstin || \"Not Found\",\n    seller_email: seller.email || \"Not Found\",\n    seller_phone: seller.phone || \"Not Found\",\n\n    // Invoice\n    invoice_number: invoice.invoice_number || \"Not Found\",\n    invoice_date: invoice.invoice_date || \"Not Found\",\n    due_date: invoice.due_date || \"Not Found\",\n\n    // Customer\n    customer_name: customer.name || \"Not Found\",\n    customer_address: customer.address || \"Not Found\",\n    customer_gstin: customer.gstin || \"Not Found\",\n\n    // Items\n    items: JSON.stringify(invoice.items || []),\n\n    // Amounts\n    subtotal: invoice.subtotal || \"Not Found\",\n    cgst: taxes.cgst || \"Not Found\",\n    sgst: taxes.sgst || \"Not Found\",\n    igst: taxes.igst || \"Not Found\",\n    grand_total: invoice.grand_total || \"Not Found\",\n\n    // Payment\n    bank_name: payment.bank_name || \"Not Found\",\n    account_name: payment.account_name || \"Not Found\",\n    account_number: payment.account_number || \"Not Found\",\n    ifsc: payment.ifsc || \"Not Found\",\n    payment_terms: payment.payment_terms || \"Not Found\",\n\n    // Risk\n    risk_level: data.risk_assessment || \"Not Found\",\n\n    // Issues\n    issues_found: (data.issues_found || []).join(\"; \"),\n\n    // Recommendations\n    recommendations: (data.recommendations || []).join(\"; \")\n  }\n}];"
      },
