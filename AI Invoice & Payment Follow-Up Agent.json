          "id": "edJAzo9yaNKu0gXa",
          "name": "Google Gemini(PaLM) Api account 3"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"invoiceId\": \"INV-1001\",\n  \"customerName\": \"Rahul Sharma\",\n  \"customerEmail\": \"rahul@example.com\",\n  \"company\": \"ABC Technologies\",\n  \"invoiceAmount\": 75000,\n  \"dueDate\": \"2026-09-15\",\n  \"paymentStatus\": \"OVERDUE\",\n  \"daysOverdue\": 6,\n  \"urgency\": \"High\",\n  \"recommendedAction\": \"Send an immediate payment reminder and request payment confirmation.\",\n  \"followUpMessage\": \"Dear Rahul, this is a friendly reminder that invoice INV-1001 for ₹75,000 is overdue. Please arrange payment at your earliest convenience.\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        80,
        160
      ],
      "id": "713054dd-bf15-4c03-a4de-66b2a23f84df",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.output ?? $json;\n\nlet data;\n\nif (typeof raw === \"string\") {\n  try {\n    data = JSON.parse(raw);\n  } catch (error) {\n    throw new Error(\"AI output is not valid JSON: \" + raw);\n  }\n} else {\n  data = raw;\n}\n\n// Get original invoice information\nconst dueDate = String(data.dueDate || \"\").trim();\nconst originalStatus = String(data.paymentStatus || \"\").toUpperCase();\n\n// Today's date\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\n// Due date\nconst due = new Date(dueDate + \"T00:00:00\");\ndue.setHours(0, 0, 0, 0);\n\n// Calculate days difference\nconst differenceMs = due.getTime() - today.getTime();\nconst daysUntilDue = Math.ceil(differenceMs / (1000 * 60 * 60 * 24));\n\nlet paymentStatus;\nlet daysOverdue;\nlet urgency;\n\n// If already paid\nif (originalStatus === \"PAID\") {\n  paymentStatus = \"PAID\";\n  daysOverdue = 0;\n  urgency = \"Low\";\n}\n\n// If due date has passed\nelse if (daysUntilDue < 0) {\n  paymentStatus = \"OVERDUE\";\n  daysOverdue = Math.abs(daysUntilDue);\n  urgency = \"High\";\n}\n\n// If due today or within next 7 days\nelse if (daysUntilDue <= 7) {\n  paymentStatus = \"DUE_SOON\";\n  daysOverdue = 0;\n  urgency = \"Medium\";\n}\n\n// More than 7 days remaining\nelse {\n  paymentStatus = \"NOT_DUE\";\n  daysOverdue = 0;\n  urgency = \"Low\";\n}\n\nreturn [\n  {\n    json: {\n      ...data,\n      paymentStatus,\n      daysOverdue,\n      urgency,\n      daysUntilDue\n    }\n  }\n];"
      },
