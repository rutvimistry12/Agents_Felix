    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this invoice and payment information.\n\nInvoice ID: {{$json.invoiceId}}\nCustomer Name: {{$json.customerName}}\nCustomer Email: {{$json.customerEmail}}\nCompany: {{$json.company}}\nInvoice Amount: {{$json.invoiceAmount}}\nInvoice Date: {{$json.invoiceDate}}\nDue Date: {{$json.dueDate}}\nPayment Status: {{$json.paymentStatus}}\nPayment Method: {{$json.paymentMethod}}\nDescription: {{$json.description}}\n\nDetermine:\n\n1. Payment status\n2. Whether the invoice is overdue\n3. Days overdue\n4. Payment urgency\n5. Recommended action\n6. A professional payment follow-up message\n\nDo not invent information.\n\nReturn ONLY valid JSON.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an AI Invoice and Payment Follow-Up Agent.\n\nYour job is to analyze invoices and determine their payment status.\n\nClassify paymentStatus as exactly one of:\n\nPAID\nOVERDUE\nDUE_SOON\nNOT_DUE\n\nRules:\n\nPAID:\nThe invoice has already been paid.\n\nOVERDUE:\nThe invoice is unpaid and the due date has passed.\n\nDUE_SOON:\nThe invoice is unpaid and the due date is approaching within 7 days.\n\nNOT_DUE:\nThe invoice is unpaid but the due date is more than 7 days away.\n\nDetermine urgency as exactly one of:\n\nHigh\nMedium\nLow\n\nHigh:\nInvoice is overdue.\n\nMedium:\nInvoice is due within 7 days.\n\nLow:\nInvoice is not due yet or already paid.\n\ndaysOverdue must be 0 when the invoice is not overdue.\n\nGenerate a short, professional payment follow-up message.\n\nDo not invent payment information.\n\nReturn only valid JSON using exactly this structure:\n\n{\n  \"invoiceId\": \"\",\n  \"customerName\": \"\",\n  \"customerEmail\": \"\",\n  \"company\": \"\",\n  \"invoiceAmount\": 0,\n  \"dueDate\": \"\",\n  \"paymentStatus\": \"\",\n  \"daysOverdue\": 0,\n  \"urgency\": \"\",\n  \"recommendedAction\": \"\",\n  \"followUpMessage\": \"\"\n}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -96,
        -48
      ],
      "id": "1912e7d1-0783-4c09-8e3e-e675c1f21504",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        -188,
        160
      ],
      "id": "b0dbac3c-0e43-46ae-aac7-e904e599812f",
