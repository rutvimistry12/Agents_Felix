{
  "name": "Advanced Medical Assistance Agent",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Advanced Medical Assistance",
        "formDescription": "Get general health information, understand symptoms and medical terminology,\nreview medical reports, prepare for medical appointments, and receive\nappropriate guidance about when professional medical care may be needed.\n\nThis service does not replace a doctor or emergency medical services.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Full Name",
              "fieldName": "Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Gender",
              "fieldType": "radio",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Male"
                  },
                  {
                    "option": "Female"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Current Symptoms",
              "fieldType": "textarea",
              "fieldName": "symptoms",
              "placeholder": "Describe your curent symptones in details",
              "requiredField": true
            },
            {
              "fieldLabel": "Duration of Symptoms",
              "fieldName": "Duration",
              "placeholder": "e.g., 3 days, 2 weeks",
              "requiredField": true
            },
            {
              "fieldLabel": "Severity Level",
              "fieldType": "dropdown",
              "fieldName": "severity",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Mild"
                  },
                  {
                    "option": "Moderate"
                  },
                  {
                    "option": "Severe"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Medical history",
              "fieldName": "Medical history",
              "placeholder": "Any chronic condition,past surgeries,etc"
            },
            {
              "fieldLabel": "Current Medications",
              "fieldType": "textarea",
              "fieldName": "Medications",
              "placeholder": "List all Medications you are currently talking"
            },
            {
              "fieldLabel": "Allergies",
              "fieldName": "Allergies",
              "placeholder": "Any known allergies to medications,food, etc"
            },
            {
              "fieldLabel": "Lifestyle Factors",
              "fieldName": "Lifestyle factors",
              "placeholder": "Smoking,alcohol,exercise habits,diet,etc."
            },
            {
              "fieldLabel": "age",
              "fieldType": "number",
              "fieldName": "age",
              "requiredField": true
            },
            {
              "fieldLabel": "Emergency Symptoms / Warning Signs",
              "fieldType": "textarea",
              "fieldName": "emergency_symptoms",
              "placeholder": "Have you experienced severe difficulty breathing, loss of consciousness, severe chest pressure/pain, sudden weakness, severe bleeding, or another symptom that feels immediately dangerous?"
            },
            {
              "fieldLabel": "Existing Conditions",
              "fieldType": "textarea",
              "placeholder": "Existing Conditions? how are you now ?",
              "requiredField": true
            },
            {
              "fieldLabel": "Medical Report",
              "fieldType": "file"
            },
            {
              "fieldLabel": "Assistant Type",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Symptoms"
                  },
                  {
                    "option": "Medication Information"
                  },
                  {
                    "option": "Medical Report"
                  },
                  {
                    "option": "General Health"
                  },
                  {
                    "option": "Appointment Preparation"
                  },
                  {
                    "option": "First Aid Information"
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Thank you ,your medical information has been received and it being assessed.you will  receive a detailed report shortly "
            }
          }
        }
      },
