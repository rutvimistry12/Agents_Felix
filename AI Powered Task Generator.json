          "id": "lnYFfhqKYm4FH0mI",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Get AI Agent output\nlet rawOutput = $json.output || \"\";\n\n// Remove accidental Markdown code fences\nrawOutput = rawOutput\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nlet data;\n\n// Try to parse JSON\ntry {\n  data = JSON.parse(rawOutput);\n} catch (error) {\n\n  // Try to find JSON object inside the AI response\n  const start = rawOutput.indexOf(\"{\");\n  const end = rawOutput.lastIndexOf(\"}\");\n\n  if (start !== -1 && end !== -1) {\n\n    const jsonText = rawOutput.substring(start, end + 1);\n\n    try {\n      data = JSON.parse(jsonText);\n    } catch (error2) {\n      throw new Error(\n        \"AI Agent did not return valid JSON. Please check the AI Agent prompt.\"\n      );\n    }\n\n  } else {\n    throw new Error(\n      \"AI Agent did not return JSON. Please check the AI Agent prompt.\"\n    );\n  }\n}\n\n// Get tasks\nconst tasks = data.tasks || [];\n\n// Convert tasks into separate n8n items\nreturn tasks.map((task, index) => {\n\n  return {\n    json: {\n      id: index + 1,\n      task_title: task.task_title || \"\",\n      description: task.description || \"\",\n      priority: task.priority || \"\",\n      estimated_time: task.estimated_time || \"\",\n      deadline: task.deadline || \"\",\n      category: task.category || \"\"\n    }\n  };\n\n});"
      },
