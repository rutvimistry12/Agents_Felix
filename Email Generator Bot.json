      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst name = data[\"Full name\"] || \"\";\nconst email = data[\"Recipient email\"] || \"\";\nconst purpose = data[\"Purpose\"] || \"\";\nconst tone = data[\"Tone\"] || \"\";\nconst recipientName = data[\"Recipient Name\"] || \"\";\nconst additionalNotes = data[\"Additional Notes\"] || \"\";\n\nconst subject = purpose;\n\nconst emailPrompt = `\nWrite a professional email.\n\nSender Name: ${name}\nRecipient Email: ${email}\nRecipient Name: ${recipientName}\nPurpose: ${purpose}\nTone: ${tone}\nAdditional Notes: ${additionalNotes}\nSubject: ${subject}\n\nRequirements:\n- Use the requested tone.\n- Address the recipient by name.\n- Clearly communicate the purpose.\n- Use the additional notes.\n- Keep it concise and natural.\n- Include a greeting and professional closing.\n- Do not invent information.\n- Return only the email body.\n`.trim();\n\nreturn [{\n  json: {\n    name,\n    email,\n    recipientName,\n    purpose,\n    tone,\n    additionalNotes,\n    subject,\n    emailPrompt\n  }\n}];"
      },
