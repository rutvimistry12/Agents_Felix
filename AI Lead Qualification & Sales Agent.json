      "parameters": {
        "jsonSchemaExample": "{\n  \"leadName\": \"Rahul Sharma\",\n  \"email\": \"rahul@example.com\",\n  \"company\": \"ABC Technologies\",\n  \"jobTitle\": \"Founder\",\n  \"interest\": \"AI Automation\",\n  \"budget\": \"100000\",\n  \"timeline\": \"Within 1 month\",\n  \"leadScore\": 92,\n  \"leadCategory\": \"HOT\",\n  \"buyingIntent\": \"High\",\n  \"qualification\": \"Qualified\",\n  \"keyRequirements\": [\n    \"AI chatbot\",\n    \"CRM automation\"\n  ],\n  \"painPoints\": [\n    \"Manual lead management\"\n  ],\n  \"missingInformation\": [\n    \"Decision-making authority\"\n  ],\n  \"recommendedAction\": \"Schedule a sales demo within 24 hours\",\n  \"salesMessage\": \"Hi Rahul, thank you for your interest in AI automation.\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        192,
        176
      ],
      "id": "7ab1f303-cab1-49e6-a752-c3ea45818823",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.output ?? $json;\n\nlet data;\n\nif (typeof raw === 'string') {\n  try {\n    data = JSON.parse(raw);\n  } catch (error) {\n    throw new Error('AI output is not valid JSON: ' + raw);\n  }\n} else {\n  data = raw;\n}\n\nconst score = Math.max(\n  0,\n  Math.min(100, Number(data.leadScore ?? 0))\n);\n\nlet category;\n\nif (score >= 80) {\n  category = \"HOT\";\n} else if (score >= 50) {\n  category = \"WARM\";\n} else {\n  category = \"COLD\";\n}\n\nreturn [\n  {\n    json: {\n      ...data,\n      leadScore: score,\n      leadCategory: category\n    }\n  }\n];"
      },
