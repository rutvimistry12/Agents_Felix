{
  "name": "Automated Attendance Logging Bot",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst user = $('Parse Command').first().json;\n\nconst todayRows = rows.filter(item => {\n  const row = item.json;\n\n  return String(row.telegramId) === String(user.telegramId)\n    && String(row.date) === String(user.date);\n});\n\nif (todayRows.length === 0) {\n  return [{\n    json: {\n      telegramId: user.telegramId,\n      message:\n        `📊 Today's Attendance\\n\\n` +\n        `👤 ${user.fullName}\\n` +\n        `📅 ${user.date}\\n\\n` +\n        `❌ No attendance marked today.`\n    }\n  }];\n}\n\nconst row = todayRows[0].json;\n\nreturn [{\n  json: {\n    telegramId: user.telegramId,\n    message:\n      `📊 Today's Attendance\\n\\n` +\n      `👤 ${row.fullName}\\n` +\n      `📅 ${row.date}\\n` +\n      `🕐 ${row.time}\\n` +\n      `📌 Status: ${row.status}`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
