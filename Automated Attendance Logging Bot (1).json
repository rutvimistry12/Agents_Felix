    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst user = $('Parse Command').first().json;\n\nconst userRows = rows.filter(item =>\n  String(item.json.telegramId) === String(user.telegramId)\n);\n\nconst total = userRows.length;\n\nconst present = userRows.filter(item =>\n  String(item.json.status).toLowerCase() === 'present'\n).length;\n\nconst absent = userRows.filter(item =>\n  String(item.json.status).toLowerCase() === 'absent'\n).length;\n\nconst percentage = total > 0\n  ? ((present / total) * 100).toFixed(1)\n  : '0.0';\n\nreturn [{\n  json: {\n    telegramId: user.telegramId,\n    message:\n      `📊 Attendance Status\\n\\n` +\n      `👤 ${user.fullName}\\n\\n` +\n      `📅 Total Records: ${total}\\n` +\n      `✅ Present: ${present}\\n` +\n      `❌ Absent: ${absent}\\n` +\n      `📈 Attendance Rate: ${percentage}%`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        192
      ],
      "id": "a57d5403-a02b-4d81-a453-7a961de26c4e",
      "name": "2"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst user = $('Parse Command').first().json;\n\nconst userRows = rows\n  .filter(item =>\n    String(item.json.telegramId) === String(user.telegramId)\n  )\n  .sort((a, b) =>\n    String(b.json.date).localeCompare(String(a.json.date))\n  );\n\nif (userRows.length === 0) {\n  return [{\n    json: {\n      telegramId: user.telegramId,\n      message: `📋 No attendance history found for ${user.fullName}.`\n    }\n  }];\n}\n\nconst history = userRows\n  .slice(0, 10)\n  .map(item => {\n    const r = item.json;\n\n    return `${r.date} — ${r.status}${r.time ? ` — ${r.time}` : ''}`;\n  })\n  .join('\\n');\n\nreturn [{\n  json: {\n    telegramId: user.telegramId,\n    message:\n      `📋 Attendance History\\n\\n` +\n      `👤 ${user.fullName}\\n\\n` +\n      history\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        416
      ],
      "id": "cc0565c8-496d-4de0-a17b-ef5b1fb4c595",
      "name": "3"
