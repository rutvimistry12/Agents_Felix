    {
      "parameters": {
        "jsCode": "const msg = $json.message || {};\n\nconst text = String(msg.text || '').trim();\n\nconst command = text\n  .toLowerCase()\n  .replace(/^\\//, '')\n  .split(/\\s+/)[0];\n\nconst now = $now.setZone('Asia/Kolkata');\n\nconst commands = {\n  today: 'today',\n  present: 'today',\n  checkin: 'checkin',\n  status: 'status',\n  history: 'history',\n  report: 'report',\n  help: 'help'\n};\n\nconst telegramId = String(msg.from?.id || '');\nconst date = now.toFormat('yyyy-MM-dd');\nconst time = now.toFormat('HH:mm:ss');\n\nreturn [\n  {\n    json: {\n      telegramId: telegramId,\n\n      username: msg.from?.username || 'No Username',\n\n      fullName:\n        `${msg.from?.first_name || ''} ${msg.from?.last_name || ''}`.trim()\n        || 'Unknown User',\n\n      inputText: text,\n\n      command: commands[command] || 'unknown',\n\n      date: date,\n\n      time: time,\n\n      attendanceKey: `${telegramId}_${date}`,\n\n      status: 'Present'\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        0
      ],
      "id": "12118391-c142-48a0-92a6-123302bdea5f",
      "name": "1"
